[alias]
    cstash = "!git add -A && git commit --no-verify -m \"CSTASH-ED ('git cpop' to un-stash)\""
    cpop = reset HEAD~1
    # undo accidental cpop (re-commits)
    cundo = reset @{1}
    st = status -s
    can = commit --amend --no-edit
    cam = commit --amend
    aa = add -A
    ll = log -1
    b = checkout -

[init]
    defaultBranch = main

[fetch]
    prune = true

[pull]
    # Refuse divergent pulls instead of silently choosing merge or rebase.
    ff = only

[merge]
    conflictStyle = zdiff3

# If plain `git push` becomes common, push.autoSetupRemote can replace the
# initial `--set-upstream`; `git po` already manages its upstream explicitly.
