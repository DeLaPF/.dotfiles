emulate -L zsh

local -a usage_lines=(
  'Usage: gwt <command>'
  '  -c [name] [-b|--base <branch>]'
  '                     Create new worktree (base defaults to current branch)'
  '  -e <branch>        Check out existing branch into a new worktree'
  '  -m <name>          Rename current worktree and branch using the -c naming ladder'
  '  -r [--force]       Remove current worktree'
)

case "$1" in
  ''|help|-h|--help)
    printf '%s\n' "${usage_lines[@]}"
    return 0
    ;;
  -c|-e|-m|-r) ;;
  *)
    printf 'Error: unknown command: %s\n' "$1" >&2
    printf '%s\n' "${usage_lines[@]}" >&2
    return 1
    ;;
esac

local repo_dir="$PWD"
while [[ "$repo_dir" != / && ! -d "$repo_dir/.bare" ]]; do
  repo_dir=$(dirname "$repo_dir")
done

if [[ ! -d "$repo_dir/.bare" ]]; then
  printf 'Error: could not find .bare/ directory\n' >&2
  return 1
fi

local hook_dir="$repo_dir/.worktree-hooks"

case "$1" in
  -c)
    shift
    local requested_name=""
    local worktree_name start_point
    local -i name_set=0

    while (( $# > 0 )); do
      case "$1" in
        -b|--base)
          if (( $# < 2 )) || [[ -z "$2" ]]; then
            printf 'Error: %s requires a base branch\n' "$1" >&2
            return 1
          fi
          start_point="$2"
          shift 2
          ;;
        --base=*)
          start_point="${1#--base=}"
          if [[ -z "$start_point" ]]; then
            printf 'Error: --base requires a base branch\n' >&2
            return 1
          fi
          shift
          ;;
        -h|--help)
          printf '%s\n' "${usage_lines[@]}"
          return 0
          ;;
        -*)
          printf 'Error: unknown option: %s\n' "$1" >&2
          printf '%s\n' "${usage_lines[@]}" >&2
          return 1
          ;;
        *)
          if (( name_set )); then
            printf 'Error: only one name is allowed; use --base for the base branch\n' >&2
            printf '%s\n' "${usage_lines[@]}" >&2
            return 1
          fi
          requested_name="$1"
          name_set=1
          shift
          ;;
      esac
    done

    if [[ -z "$start_point" ]]; then
      start_point=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || {
        printf 'Error: could not infer a base; run from a worktree or pass --base <branch>\n' >&2
        return 1
      }
    fi
    worktree_name=$(_gwt_branch_name "$repo_dir" "$requested_name") || return
    git -C "$repo_dir/.bare" worktree add "$repo_dir/$worktree_name" -b "$worktree_name" "$start_point" &&
      _gwt_post_create "$repo_dir" "$hook_dir" "$repo_dir/$worktree_name"
    ;;
  -e)
    local branch="$2"
    if [[ -z "$branch" ]]; then
      printf 'Usage: gwt -e <existing-branch>\n' >&2
      return 1
    fi
    local worktree_dir="${branch//\//__}"
    if [[ -e "$repo_dir/$worktree_dir" || -L "$repo_dir/$worktree_dir" ]]; then
      printf 'Error: worktree path already exists: %s\n' "$repo_dir/$worktree_dir" >&2
      return 1
    fi
    git check-ref-format "refs/heads/$branch" || return
    local remote merge_ref upstream
    remote=$(git -C "$repo_dir/.bare" config --get "branch.$branch.remote")
    merge_ref=$(git -C "$repo_dir/.bare" config --get "branch.$branch.merge")
    # Existing custom upstreams take precedence over origin/<branch>.
    if [[ -n "$remote" ]]; then
      if [[ "$remote" != . ]]; then
        git -C "$repo_dir/.bare" fetch -- "$remote" || return
      fi
    else
      git -C "$repo_dir/.bare" fetch origin || return
    fi
    if [[ -z "$remote" && -z "$merge_ref" ]] &&
       git -C "$repo_dir/.bare" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      if git -C "$repo_dir/.bare" show-ref --verify --quiet "refs/heads/$branch"; then
        git -C "$repo_dir/.bare" branch --set-upstream-to="origin/$branch" -- "$branch" || return
      else
        git -C "$repo_dir/.bare" branch --track -- "$branch" "origin/$branch" || return
      fi
    fi
    git -C "$repo_dir/.bare" worktree add "$repo_dir/$worktree_dir" "$branch" || return
    upstream=$(git -C "$repo_dir/$worktree_dir" rev-parse --verify --quiet '@{upstream}')
    if [[ -n "$upstream" ]]; then
      if git -C "$repo_dir/$worktree_dir" merge-base --is-ancestor HEAD "$upstream"; then
        git -C "$repo_dir/$worktree_dir" merge --ff-only "$upstream" || return
      elif ! git -C "$repo_dir/$worktree_dir" merge-base --is-ancestor "$upstream" HEAD; then
        printf 'Branch %s has diverged from its upstream; kept local commits unchanged.\n' "$branch" >&2
      fi
    fi
    _gwt_post_create "$repo_dir" "$hook_dir" "$repo_dir/$worktree_dir"
    ;;
  -r)
    shift
    local worktree_path locked_dir
    worktree_path=$(git rev-parse --show-toplevel 2>/dev/null) || {
      printf 'Error: not inside a worktree\n' >&2
      return 1
    }
    if [[ -x "$hook_dir/on-remove" ]]; then
      "$hook_dir/on-remove" "$worktree_path" || return
    fi
    while IFS= read -r -d '' locked_dir; do
      chmod u+w -- "$locked_dir" || return
    done < <(find "$worktree_path" -xdev -type d -user "$EUID" ! -perm -u+w -print0)
    cd "$repo_dir" && git -C "$repo_dir/.bare" worktree remove "$@" "$worktree_path"
    ;;
  -m)
    local new_name="$2"
    if [[ -z "$new_name" ]]; then
      printf 'Usage: gwt -m <name>\n' >&2
      return 1
    fi
    local worktree_path current_branch worktree_name target_path
    worktree_path=$(git rev-parse --show-toplevel 2>/dev/null) || {
      printf 'Error: not inside a worktree\n' >&2
      return 1
    }
    current_branch=$(git -C "$worktree_path" branch --show-current) || return
    worktree_name=$(_gwt_branch_name "$repo_dir" "$new_name" "$current_branch" "$worktree_path") || return
    target_path="$repo_dir/$worktree_name"

    if [[ "$current_branch" != "$worktree_name" ]]; then
      git -C "$worktree_path" branch -m "$worktree_name" || return
    fi
    if [[ "${worktree_path:A}" != "${target_path:A}" ]]; then
      git -C "$repo_dir/.bare" worktree move "$worktree_path" "$target_path" || return
    fi
    cd "$target_path"
    ;;
esac
