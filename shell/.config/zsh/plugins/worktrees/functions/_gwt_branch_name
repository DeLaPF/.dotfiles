emulate -L zsh

local repo_dir="$1"
local requested_name="$2"
local current_branch="$3"
local current_worktree="$4"
local github_user date_stamp time_stamp candidate target_path
local -i branch_available directory_available
local -a candidates

if (( ! $+commands[gh] )); then
  printf 'Error: gwt requires GitHub CLI (gh) to determine the branch prefix\n' >&2
  return 1
fi
github_user=$(gh api user --jq .login) || {
  printf 'Error: gwt could not determine the authenticated GitHub login\n' >&2
  return 1
}
github_user=${${github_user:l}// /_}

date_stamp=$(date +%Y_%m_%d)
time_stamp=$(date +%H_%M)

if [[ -n "$requested_name" ]]; then
  candidates=(
    "${github_user}__${requested_name}"
    "${github_user}__${requested_name}__${date_stamp}"
    "${github_user}__${requested_name}__${date_stamp}__${time_stamp}"
  )
else
  candidates=(
    "${github_user}__${date_stamp}"
    "${github_user}__${date_stamp}__${time_stamp}"
  )
fi

for candidate in $candidates; do
  target_path="$repo_dir/$candidate"
  branch_available=0
  directory_available=0

  if [[ "$candidate" == "$current_branch" ]] ||
      ! git -C "$repo_dir/.bare" show-ref --verify --quiet "refs/heads/$candidate"; then
    branch_available=1
  fi
  if [[ -n "$current_worktree" && "${target_path:A}" == "${current_worktree:A}" ]] ||
      [[ ! -e "$target_path" && ! -L "$target_path" ]]; then
    directory_available=1
  fi

  if (( branch_available && directory_available )); then
    printf '%s\n' "$candidate"
    return 0
  fi
done

printf 'Error: all worktree names for this minute are unavailable\n' >&2
return 1
