emulate -L zsh

local playground_dir="$HOME/dev/playground"
local name extension file editor_status
local new_file=0
name=$(date '+%Y%m%d%H%M')
extension=''

case "${1:-py}" in
  help|-h|--help)
    printf '%s\n' \
      'Usage: plg [py|python|name.py]' \
      'Deps: uv add --script FILE PACKAGE; run: uv run FILE'
    return
    ;;
  python|py)
    playground_dir="$playground_dir/python"
    extension=py
    ;;
  *)
    name="${1%.*}"
    extension="${1##*.}"
    case "$extension" in
      py) playground_dir="$playground_dir/python" ;;
      *)
        printf 'Unknown command: %s\n' "$1" >&2
        return 1
        ;;
    esac
    ;;
esac

[[ -d "$playground_dir" ]] || mkdir -p "$playground_dir" || return
cd "$playground_dir" || return
file="$name.$extension"
[[ -e "$file" ]] || new_file=1
"$EDITOR" "$file"
editor_status=$?

if (( editor_status == 0 && new_file )); then
  printf 'uv: add deps with `uv add --script %s PACKAGE`; run with `uv run %s`\n' "$file" "$file"
fi
return "$editor_status"
