emulate -L zsh

local branch repo default_branch
local -a push_args
branch=$(git rev-parse --abbrev-ref HEAD) || return
repo=$(git remote get-url origin | sed -E 's|.*github\.com[:/](.+)(\.git)?$|\1|' | sed 's/\.git$//') || return
default_branch=$(git remote show origin | sed -n 's/.*HEAD branch: //p') || return
[[ -n "$1" ]] && push_args+=("$1")
git "${push_args[@]}" push -u origin "$branch" || return

_link "https://github.com/$repo/compare/$default_branch...$branch" 'Click to Open PR'
